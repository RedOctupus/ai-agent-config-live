# Hermes Agent - Environment Variables Template
# Copy to ~/.hermes/.env and fill in your values

# Primary Model Provider (DeepSeek)
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI (for Codex CLI, image generation, auxiliary tasks)
OPENAI_API_KEY=your-openai-api-key

# GitHub (for gh CLI and API access)
GITHUB_TOKEN=your-github-token

# Optional: OpenRouter (multi-provider gateway)
# OPENROUTER_API_KEY=your-openrouter-key

# Optional: Anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Google Gemini
# GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Optional: HuggingFace
# HF_TOKEN=your-huggingface-token

# Optional: ElevenLabs (TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-key
